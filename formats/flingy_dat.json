{
  "title": "flingy.dat",
  "spec": [
    {
      "name": "Sprite",
      "offset": "0x0000",
      "length": "418 bytes (2 bytes / Flingy)",
      "description": "The sprites.dat entry created for this flingy. StarEdit uses it to draw units on the map.",
      "values": "Integer value between 0 and 516.",
      "bits": []
    },
    {
      "name": "Top Speed",
      "offset": "0x01A2",
      "length": "836 bytes (4 bytes / Flingy)",
      "description": "Highest speed, in 1/256 pixels per frame (1280 is 5 pixels per frame). For Movement Control 0 and 1, speed upgrades and Stim Packs raise it by half (to at least 853; the Scout gets 1707) and Ensnare halves it. For Movement Control 2 the value is only a starting point: when a unit is created, the game works out its speed from the distances its walking animation moves over 32 frames, so walking units have the placeholder 1 here. 0 means the flingy never moves.",
      "values": "Integer value between 0 and 2147483647.",
      "bits": []
    },
    {
      "name": "Acceleration",
      "offset": "0x04E6",
      "length": "418 bytes (2 bytes / Flingy)",
      "description": "How much the speed changes each frame when speeding up or braking, in 1/256 pixels per frame. Doubled with speed upgrades or Stim Packs and reduced to 3/4 by Ensnare. Movement Control 2 does not use it. With Movement Control 0 or 1, 0 means the flingy never gets going.",
      "values": "Integer value between 0 and 65535.",
      "bits": []
    },
    {
      "name": "Halt Distance",
      "offset": "0x0688",
      "length": "836 bytes (4 bytes / Flingy)",
      "description": "Distance from the target, in 1/256 pixels, at which a flingy with Movement Control 0 starts braking. It is only a stored shortcut for speed² ÷ (2 × acceleration): the game uses it only while the unit moves at exactly Top Speed with exactly Acceleration, and works the distance out itself otherwise. A few shipped values don't match the formula (Science Vessel, Corsair, and the Dropship and Valkyrie since 1.08), so those units brake later than the formula says when at full speed.",
      "values": "Integer value between 0 and 4294967295.",
      "bits": []
    },
    {
      "name": "Turn Rate",
      "offset": "0x09CC",
      "length": "209 bytes (1 byte / Flingy)",
      "description": "How far the flingy may turn in one frame, in 256ths of a full turn (40 turns half way round in 4 frames). With Movement Control 0 and 1 the direction of travel follows the facing at half this rate. Speed upgrades and Stim Packs double it and Ensnare reduces it to 3/4. The game compares it as a signed number, so 128 to 255 act as negative values and the flingy never settles on a direction. A moving flingy with Movement Control 0 or 1 and a turn rate of 0 crashes the game (a division by zero) when it comes within 32 pixels of a target it is not facing. Homing bullets of flingies 141 to 171 and 201 to 206 turn one step faster each frame they turn.",
      "values": "Integer value between 1 and 127.",
      "bits": []
    },
    {
      "name": "Unused",
      "offset": "0x0A9D",
      "length": "209 bytes (1 byte / Flingy)",
      "description": "Not used: no code in StarCraft or StarEdit reads this field, in any version from 1.04 to 1.17. The shipped values (30 for most flyers, 24, 20 and 60 for some, 127 for the rest) look like a banking angle for flyers that was never used.",
      "values": "Any value; ignored.",
      "bits": []
    },
    {
      "name": "Movement Control",
      "offset": "0x0B6E",
      "length": "209 bytes (1 byte / Flingy)",
      "description": "How the flingy's speed is controlled.",
      "values": "Values above 2 have no case of their own: the flingy accelerates like 1 but never stops on arrival, and speed upgrades do not apply.",
      "bits": [
        {
          "bit": "0x00",
          "value": "Flingy control: accelerates to Top Speed, brakes when Halt Distance from the target, and stops once slower than 192 at the target. Most flying units and workers"
        },
        {
          "bit": "0x01",
          "value": "Accelerate without braking: stops dead on arrival. Most moving bullets, and the High Templar, the Terran buildings that lift off and the Nuclear Missile"
        },
        {
          "bit": "0x02",
          "value": "Animation control: the unit moves by the distances its animation script gives each frame, without acceleration or braking, and only once it faces where it is going. Walking units, buildings and stationary effects"
        }
      ]
    }
  ],
